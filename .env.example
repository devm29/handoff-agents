# Copy to .env and adjust. Every backend variable is read by pydantic-settings.

# development enables one-click demo sign-in; production refuses the demo reviewer tokens.
HANDOFF_ENVIRONMENT=development

# PostgreSQL (checkpoints, runs, approvals, run events). Plain postgresql:// URL.
HANDOFF_DATABASE_URL=postgresql://handoff@127.0.0.1:5504/handoff
TEST_DATABASE_URL=postgresql://handoff@127.0.0.1:5504/handoff_test
# API and worker apply Alembic migrations on startup; turn off to run `handoff db init` yourself.
HANDOFF_AUTO_MIGRATE=true

# API
HANDOFF_API_HOST=127.0.0.1
HANDOFF_API_PORT=8104
HANDOFF_CORS_ORIGINS=["http://localhost:3104","http://127.0.0.1:3104"]
HANDOFF_LOG_LEVEL=INFO
HANDOFF_LOG_JSON=false

# Model provider: "fake" runs fully offline with a scripted model; "anthropic" calls Claude.
HANDOFF_LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
HANDOFF_MODEL=claude-opus-5-5
HANDOFF_JUDGE_MODEL=claude-opus-5-5
HANDOFF_EFFORT=medium
HANDOFF_REFUSAL_FALLBACK=true
# Artificial latency for the fake model so the live graph is watchable.
HANDOFF_FAKE_LATENCY_MS=350

# MCP tools: "stdio" spawns the bundled server, "http" talks to a running one, "inprocess" for tests.
HANDOFF_MCP_TRANSPORT=stdio
HANDOFF_MCP_URL=http://127.0.0.1:8000/mcp

# Governance
HANDOFF_DEFAULT_MAX_TOKENS=120000
HANDOFF_DEFAULT_MAX_USD=1.50
HANDOFF_NODE_MAX_ATTEMPTS=3
HANDOFF_AGENT_MAX_TURNS=8
HANDOFF_APPROVAL_TIMEOUT_SECONDS=3600
HANDOFF_ESCALATION_TIERS=["analyst","compliance-lead","chief-risk-officer"]
# Reviewer accounts (bearer tokens). Defaults to three demo-* accounts; set real ones outside development.
# HANDOFF_REVIEWERS=[{"name":"Priya Raman","role":"analyst","token":"change-me-at-least-12"}]
HANDOFF_SESSION_COOKIE_SECURE=false
HANDOFF_AUTO_APPROVE_MAX_RISK=low

# Worker. The id defaults to host-pid-random so concurrent workers never share one.
# HANDOFF_WORKER_ID=
HANDOFF_WORKER_CONCURRENCY=4
HANDOFF_WORKER_LEASE_SECONDS=30

# OpenTelemetry: set to an OTLP/HTTP collector (e.g. http://localhost:4318) to export GenAI spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
HANDOFF_OTEL_CONSOLE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8104/api
